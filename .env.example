# Optional override for the default YAML path.
ACTIVE_OCR_CONFIG=config/default.yaml

# Label Studio API credentials. Keep real values in .env, which is ignored.
ACTIVE_OCR_LABEL_STUDIO_TOKEN=

# Remote GPU API is expected to be exposed locally through an SSH tunnel.
ACTIVE_OCR_GPU_TOKEN=

ACTIVE_OCR_LOG_LEVEL=INFO
ACTIVE_OCR_DOCUMENTS_DIR=./var/documents
