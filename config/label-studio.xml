<View>
  <Header value="Draw one box around each text line, then transcribe it exactly." />
  <Text value="Use [ILLEGIBLE] when a line cannot be read reliably." />

  <Image
    name="image"
    value="$image"
    zoom="true"
    zoomControl="true"
    rotateControl="true"
  />

  <RectangleLabels name="bbox" toName="image">
    <Label value="Text Line" background="#2563EB" />
  </RectangleLabels>

  <TextArea
    name="transcription"
    toName="image"
    perRegion="true"
    editable="true"
    required="true"
    rows="2"
    placeholder="Exact line transcription"
  />

  <Choices name="legibility" toName="image" perRegion="true" choice="single-radio">
    <Choice value="Legible" selected="true" />
    <Choice value="Illegible" />
  </Choices>

  <Choices name="page_status" toName="image" choice="single-radio" required="true">
    <Choice value="Usable" selected="true" />
    <Choice value="No Text" />
    <Choice value="Corrupt" />
  </Choices>
</View>
